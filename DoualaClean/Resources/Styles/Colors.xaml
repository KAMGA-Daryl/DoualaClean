                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- Charte DoualaClean (logo) -->
    <Color x:Key="Brand">#0B5A6B</Color>
    <Color x:Key="BrandLight">#12A58B</Color>
