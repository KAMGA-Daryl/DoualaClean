<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DoualaClean.ViewModels"
             xmlns:m="clr-namespace:DoualaClean.Models"
             xmlns:c="clr-namespace:DoualaClean.Controls"
             x:Class="DoualaClean.Views.HomePage"
             x:DataType="vm:HomeViewModel" Title="Accueil">
    <ScrollView>
        <VerticalStackLayout Padding="24,40,24,24" Spacing="20">
            <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="10">
                <Image Source="logo.png" HeightRequest="60" Aspect="AspectFit" />
            </Border>
            <VerticalStackLayout Spacing="4">
                <Label Text="Bienvenue sur DoualaClean" Style="{StaticResource Title}" FontSize="24" />
                <Label Text="{Binding UserName, StringFormat='Bonjour {0} 👋'}" HorizontalOptions="Center" />
                <Label Text="{Binding GreenPoints, StringFormat='🌿 {0} Green Points'}" Style="{StaticResource Muted}" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" RowDefinitions="150,150,150" ColumnSpacing="16" RowSpacing="16">
                <Border Style="{StaticResource Card}" Grid.Row="0" Grid.Column="0">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                        <Label Text="📸" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Signaler un dépôt" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoReportCommand}" /></Border.GestureRecognizers>
                </Border>
                <Border Style="{StaticResource Card}" Grid.Row="0" Grid.Column="1">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                        <Label Text="🗺️" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Carte des bacs" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoBinsCommand}" /></Border.GestureRecognizers>
                </Border>
                <Border Style="{StaticResource Card}" Grid.Row="1" Grid.Column="0">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                        <Label Text="♻️" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Guide de tri" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoGuideCommand}" /></Border.GestureRecognizers>
                </Border>
                <Border Style="{StaticResource Card}" Grid.Row="1" Grid.Column="1">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                        <Label Text="📋" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Suivi des signalements" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoTrackingCommand}" /></Border.GestureRecognizers>
                </Border>
                <Border Style="{StaticResource Card}" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                    <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="14">
                        <Label Text="👤" FontSize="40" VerticalOptions="Center" />
                        <Label Text="Profil" FontAttributes="Bold" FontSize="18" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoProfileCommand}" /></Border.GestureRecognizers>
                </Border>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
