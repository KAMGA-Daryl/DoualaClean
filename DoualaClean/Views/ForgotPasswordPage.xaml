<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DoualaClean.ViewModels"
             xmlns:m="clr-namespace:DoualaClean.Models"
             xmlns:c="clr-namespace:DoualaClean.Controls"
             x:Class="DoualaClean.Views.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel" Title="Récupération">
    <ScrollView>
        <VerticalStackLayout Padding="24,30,24,32" Spacing="16">
            <c:BackButton />
            <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="12" Margin="8,8,8,0">
                <Image Source="logo.png" HeightRequest="80" Aspect="AspectFit" />
            </Border>
            <Label Text="Récupération" Style="{StaticResource Title}" Margin="0,28,0,0" />
            <Label Text="Entrez l'email de votre compte, nous vous enverrons un lien pour réinitialiser votre mot de passe."
                   Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />

            <Border BackgroundColor="White" Stroke="#DADCE0" StrokeThickness="1" StrokeShape="RoundRectangle 28"
                    HeightRequest="56" Padding="18,0" HorizontalOptions="Center"
                    SemanticProperties.Description="Continuer avec Google" SemanticProperties.Hint="Récupérer l'accès à votre compte avec Google">
                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                    <Image Source="google_g.png" WidthRequest="26" HeightRequest="26" VerticalOptions="Center" />
                    <Label Text="Continuer avec Google" TextColor="#3C4043" FontAttributes="Bold" FontSize="16" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoogleCommand}" /></Border.GestureRecognizers>
            </Border>
            <Label Text="ou" Style="{StaticResource Muted}" HorizontalOptions="Center" />

            <Entry Placeholder="Entrez votre email" Keyboard="Email" Text="{Binding Email}"
                   ReturnType="Send" ReturnCommand="{Binding SendCommand}" />
            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Style="{StaticResource Error}" />

            <Button Text="Envoyer" Command="{Binding SendCommand}" IsEnabled="{Binding IsNotBusy}" Margin="0,16,0,0" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Label Text="Pas encore de compte ? S'inscrire" Style="{StaticResource Link}" Margin="0,24,0,0">
                <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding GoRegisterCommand}" /></Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
