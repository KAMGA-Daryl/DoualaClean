<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DoualaClean.ViewModels"
             xmlns:m="clr-namespace:DoualaClean.Models"
             xmlns:c="clr-namespace:DoualaClean.Controls"
             x:Class="DoualaClean.Views.SortingGuidePage"
             x:DataType="vm:SortingGuideViewModel" Title="Guide de tri">
    <ScrollView>
        <VerticalStackLayout Padding="24,30,24,32" Spacing="16">
            <c:BackButton />
            <Label Text="Guide de tri" Style="{StaticResource Title}" Margin="0,8,0,16" />
            <VerticalStackLayout Spacing="16" BindableLayout.ItemsSource="{Binding Categories}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="m:SortingCategory">
                        <Border Style="{StaticResource Card}" HeightRequest="90">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <Label Text="{Binding Icon}" FontSize="36" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding Title}" FontAttributes="Bold" FontSize="18" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="›" FontSize="26" VerticalOptions="Center" />
                            </Grid>
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCategoryTapped" /></Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
